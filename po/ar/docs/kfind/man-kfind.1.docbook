<refentry lang="&language;">
<refentryinfo>
<title
>دليل مستخدم بحثك</title>
<author
>&Lauri.Watts; &Lauri.Watts.mail;</author>
<date
>2016-11-05</date>
<releaseinfo
>تطبيقات 16.12</releaseinfo>
<productname
